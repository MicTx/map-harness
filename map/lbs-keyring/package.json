{
  "name": "@map-harness/lbs-keyring",
  "description": "LBS key pools: ordered per-vendor credential references, per-key status and usage modes (round-robin, priority, random) resolved for map LBS consumers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./policy": {
      "types": "./lib/types/policy.d.ts",
      "default": "./lib/policy.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "test": "node --test --experimental-strip-types tests/*.spec.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/contract.js",
    "lib/policy.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "LicenseRef-Map-Harness-Use-Only",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  }
}
