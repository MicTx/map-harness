{
  "name": "@map-harness/map-container",
  "description": "Map Harness map container: the ctx.map service (node half) and the ArcGIS MapView/SceneView right-Sidebar tab (browser half)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./wayback-worker": "./lib/wayback-worker.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "slots",
        "locale",
        "sidebarRightTabs",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "test": "node --test --experimental-strip-types --import ./tests/register-css.mjs tests/*.spec.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/wayback-worker.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "peerDependencies": {
    "@arcgis/core": "^5.1.0",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@arcgis/core": "5.1.24",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-resources": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-tool": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@map-harness/lbs-keyring": "workspace:*",
    "@tsdown/css": "0.22.2",
    "@types/http-cache-semantics": "4.2.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@esri/wayback-core": "1.2.0",
    "@map-harness/map-layers": "workspace:^",
    "@map-harness/spatial-catalog": "workspace:^",
    "@map-harness/spatial-realtime": "workspace:^",
    "@map-harness/spatial-viz": "workspace:^",
    "fast-xml-parser": "5.11.1",
    "http-cache-semantics": "4.2.0",
    "ipaddr.js": "2.5.0",
    "sharp": "0.35.5",
    "@deepseek-ai/dsh-brand": "workspace:*"
  }
}
