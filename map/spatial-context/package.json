{
  "name": "@map-harness/spatial-context",
  "description": "P0c spatial context loop: the DecisionFrame domain (GoalContract/PlanState/EvidenceLedger), the decisionFrame session projection, the bounded pre-step snapshot injection, the three method cards, and the task budget ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agent": {
      "types": "./lib/types/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "node --test --experimental-strip-types tests/*.spec.mjs",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/agent.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@map-harness/map-container": "workspace:^",
    "zod": "^4.4.3"
  }
}
