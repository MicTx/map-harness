{
  "name": "@map-harness/map-tools",
  "description": "Model-facing direct and MCP-backed map tools plus spatial analysis over the ctx.map container service and workspace filesystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/mcp.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "node --test --experimental-strip-types tests/*.spec.mjs",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/mcp.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@map-harness/map-container": "workspace:^",
    "@turf/turf": "7.4.0",
    "@types/geojson": "7946.0.16",
    "proj4": "2.22.0",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "zod": "^4.4.3",
    "@map-harness/spatial-catalog": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@map-harness/spatial-context": "workspace:^",
    "@map-harness/spatial-accessibility": "workspace:^",
    "@map-harness/spatial-decision": "workspace:^",
    "@map-harness/spatial-statistics": "workspace:^"
  },
  "dependencies": {
    "@map-harness/spatial-collab": "workspace:^",
    "@map-harness/spatial-realtime": "workspace:^",
    "@map-harness/spatial-scale": "workspace:^",
    "@map-harness/spatial-terrain": "workspace:^",
    "@map-harness/spatial-viz": "workspace:^"
  }
}
